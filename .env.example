# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in buttons. The emailed code is always offered; these two are off unless
# set to 1 or true, because Supabase gives the browser no way to ask which
# providers a project has enabled — a flag set before its console work is done
# is a button that leaves for Google and comes back with "Unsupported
# provider". Read at BUILD time (NEXT_PUBLIC_ is inlined), so changing either
# needs a redeploy. Walkthrough: README, "Google and Apple sign-in".
NEXT_PUBLIC_AUTH_GOOGLE=
NEXT_PUBLIC_AUTH_APPLE=

# ── RevenueCat (subscriptions; native builds only) ────────────────────────────
# Public API keys — client-safe, one per store. Read at BUILD time like the
# flags above. Setup: README, "RevenueCat webhook".
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
# Server-only. The exact string RevenueCat's dashboard is told to send as the
# webhook's Authorization header — anyone who can call app/api/revenuecat/webhook
# without it can hand out the paid plan for free.
REVENUECAT_WEBHOOK_SECRET=

# ── App-store review accounts (comma-separated) ──────────────────────────────
# These addresses sign in with a password instead of an emailed code, and count
# as paid — see lib/auth/review.ts. The password lives only in Supabase and the
# store consoles.
NEXT_PUBLIC_REVIEW_EMAILS=

# ── Marketing site (optional) ────────────────────────────────────────────────
# Hosts that show public/site at their root instead of the app (lib/site/hosts.ts).
# Comma-separated, e.g. readfluent.example,www.readfluent.example. Empty: none.
MARKETING_HOSTS=

# Shown on /support and /privacy as the contact address (public). Leave empty until you have one.
NEXT_PUBLIC_SUPPORT_EMAIL=
